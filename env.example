# ==== Anthropic ====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ==== وضع التشغيل ====
# اتركه false في البداية لمراجعة المخرجات يدوياً. اجعله true فقط بعد التأكد من الجودة.
AUTO_PUBLISH=false

# ==== GitHub (لاستضافة الصور برابط عام يقرأه Instagram) ====
GITHUB_REPO=your-username/cyber-agent
GITHUB_BRANCH=main
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# ==== OpenAI Images API (اختياري — لخلفيات فنية أعلى جودة) ====
# اتركه فارغاً/احذف السطر لتجاهله والاستمرار بالرسم المحلي المجاني بالكامل (Pillow).
OPENAI_API_KEY=
# low | medium | high — التكلفة التقريبية للصورة: 0.02$ / 0.07$ / 0.19$
OPENAI_IMAGE_QUALITY=medium

# ==== Instagram Graph API (Meta) ====
IG_BUSINESS_ACCOUNT_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
